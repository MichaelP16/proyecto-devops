# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# Puerto HTTP de la aplicación
PORT=3000

# Ruta del archivo SQLite (en Docker se usa /app/data/tareas.db)
DB_FILE=./data/tareas.db

# Nivel de logs: debug | info | warn | error
LOG_LEVEL=info

# Solo para la demo de alertas: habilita GET /api/simular-error
ENABLE_ERROR_SIMULATION=false

# Contraseña del usuario admin de Grafana (docker compose)
GRAFANA_PASSWORD=admin
