{
  "name": "tareas-devops-itla",
  "version": "1.0.0",
  "description": "Proyecto Final de Electiva 1: Introducción a DevOps (ITLA) — app de tareas con pipeline CI/CD, Docker, pruebas y monitoreo",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:ci": "jest --coverage --ci"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^10.15.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "functions": 80,
        "branches": 70
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ]
  }
}
